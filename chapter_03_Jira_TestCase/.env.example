# Jira credentials
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=https://your-domain.atlassian.net

# Local LLM (Ollama) - the app tries this first
OLLAMA_URL=http://localhost:11434
# Run `ollama list` to see the exact model tag you have pulled
OLLAMA_MODEL=gemma3:12b

# Cloud fallback (Groq) - used automatically when Ollama is unreachable
GROQ_API_KEY=
# Groq model names change - check https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
